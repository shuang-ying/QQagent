{
  "name": "qq-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "可接入任意 AI API 的 QQ 智能体（NapCat / OneBot 11），含人格、分层记忆、情绪提取与上下文压缩",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mock:napcat": "tsx scripts/mock-napcat.ts",
    "test:stage1": "tsx scripts/test-stage1.ts",
    "test:stage2": "tsx scripts/test-stage2.ts",
    "test:stage345": "tsx scripts/test-stage345.ts",
    "test:stage6": "tsx scripts/test-stage6.ts",
    "test:stage7": "tsx scripts/test-stage7.ts",
    "test": "tsx scripts/test-stage1.ts && tsx scripts/test-stage2.ts && tsx scripts/test-stage345.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:stage6 && npm run test:stage7",
    "init": "tsx scripts/init.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "pino": "^10.3.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
